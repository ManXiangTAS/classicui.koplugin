{
  "openapi": "3.1.0",
  "info": {
    "title": "墨页 WordPress 更新中转（推荐查询式入口）",
    "version": "1.0.1",
    "description": "无需伪静态。classicui_relay 指定逻辑接口；请求清单时另传 channel。下载路径通过 classicui_relay 参数传递，JSON 格式与路径式入口相同。"
  },
  "servers": [
    {
      "url": "https://www.2001330.xyz",
      "description": "WordPress HOME，子目录部署时加上子目录"
    }
  ],
  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅外部管理接口使用；不放到 Kindle。后台另用 WordPress 管理员权限。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "schema",
          "error"
        ],
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Manifest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReadyManifest"
          },
          {
            "$ref": "#/components/schemas/NoReleaseManifest"
          }
        ]
      },
      "ReadyManifest": {
        "type": "object",
        "required": [
          "schema",
          "repo",
          "channel",
          "status",
          "stale",
          "source_checked_at",
          "release"
        ],
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "repo": {
            "type": "string",
            "const": "ManXiangTAS/classicui.koplugin"
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "testing"
            ]
          },
          "status": {
            "type": "string",
            "const": "ready"
          },
          "stale": {
            "type": "boolean"
          },
          "source_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "release": {
            "$ref": "#/components/schemas/Release"
          }
        }
      },
      "NoReleaseManifest": {
        "type": "object",
        "required": [
          "schema",
          "repo",
          "channel",
          "status",
          "stale",
          "source_checked_at",
          "release"
        ],
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "repo": {
            "type": "string",
            "const": "ManXiangTAS/classicui.koplugin"
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "testing"
            ]
          },
          "status": {
            "type": "string",
            "const": "no_release"
          },
          "stale": {
            "type": "boolean"
          },
          "source_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "release": {
            "type": "null"
          }
        }
      },
      "Release": {
        "type": "object",
        "required": [
          "version",
          "tag",
          "prerelease",
          "notes",
          "page",
          "koreader",
          "asset"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "prerelease": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "page": {
            "type": "string",
            "format": "uri"
          },
          "koreader": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          },
          "asset": {
            "$ref": "#/components/schemas/Asset"
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "name",
          "size",
          "sha256",
          "origin_url",
          "download_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^ClassicUI_.+_install\\.zip$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin_url": {
            "type": "string",
            "format": "uri"
          },
          "download_path": {
            "type": "string",
            "pattern": "^/v1/classicui/packages/[0-9A-Za-z.+-]+/[a-f0-9]{64}\\.zip$"
          }
        }
      },
      "AdminStatus": {
        "type": "object",
        "required": [
          "schema",
          "repo",
          "phase",
          "queued",
          "source_checked_at",
          "last_attempt_at",
          "error",
          "retry_at",
          "channels",
          "cache_files",
          "cache_bytes",
          "next_scheduled_at"
        ],
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "repo": {
            "type": "string",
            "const": "ManXiangTAS/classicui.koplugin"
          },
          "phase": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "failed"
            ]
          },
          "queued": {
            "type": "boolean"
          },
          "source_checked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_attempt_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "retry_at": {
            "type": "integer"
          },
          "channels": {
            "type": "object",
            "required": [
              "stable",
              "testing"
            ],
            "properties": {
              "stable": {
                "$ref": "#/components/schemas/ChannelState"
              },
              "testing": {
                "$ref": "#/components/schemas/ChannelState"
              }
            }
          },
          "cache_files": {
            "type": "integer",
            "minimum": 0
          },
          "cache_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "next_scheduled_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ChannelState": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "no_release",
              "not_ready"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/index.php": {
      "get": {
        "operationId": "queryRelay",
        "summary": "查询服务、存活、清单、包或管理状态",
        "description": "公开接口无需凭据；/admin/status 必须提供 Bearer。包响应是 ZIP，其他成功响应是 JSON。",
        "security": [
          {},
          {
            "AdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "classicui_relay",
            "in": "query",
            "required": true,
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            },
            "description": "空值或 / 为服务信息；/healthz；/v1/classicui/manifest；/v1/classicui/packages/<version>/<sha256>.zip；/admin/status"
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "stable",
                "testing"
              ]
            },
            "description": "只有 manifest 请求需要且必须提供"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "所选逻辑接口的数据；包元数据见清单",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Manifest"
                    },
                    {
                      "$ref": "#/components/schemas/AdminStatus"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              },
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "清单未变，无响应体"
          },
          "400": {
            "description": "参数或路径无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "管理密钥缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "接口不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "包已淘汰；最多刷新清单后重试下载一次",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "缓存尚未就绪或存储不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "headQueryRelay",
        "summary": "与对应 GET 状态/长度相同，无响应体",
        "security": [
          {},
          {
            "AdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "classicui_relay",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "stable",
                "testing"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应头"
          },
          "400": {
            "description": "无效请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "410": {
            "description": "包已淘汰"
          },
          "503": {
            "description": "缓存未就绪"
          }
        }
      },
      "post": {
        "operationId": "queryQueueSync",
        "summary": "安排同步或复用已有任务",
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "classicui_relay",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "/admin/sync"
              ]
            }
          }
        ],
        "responses": {
          "202": {
            "description": "已接受，无需请求体",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema",
                    "status"
                  ],
                  "properties": {
                    "schema": {
                      "type": "integer",
                      "const": 1
                    },
                    "status": {
                      "type": "string",
                      "const": "accepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "管理密钥缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "限流，等待 Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          },
          "503": {
            "description": "缓存尚未就绪或存储不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
